# --- Google 認証 ---
# サービスアカウントの JSON キーへのパス（このリポジトリ内 credentials/ を推奨）
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# --- GA4 ---
# GA4 プロパティID（数字のみ。例: 123456789）
GA4_PROPERTY_ID=

# --- Search Console ---
# 対象サイト。URLプレフィックス型 or ドメインプロパティ型のどちらか
#   URLプレフィックス型: https://hagakure-web.com/
#   ドメインプロパティ型: sc-domain:hagakure-web.com
GSC_SITE_URL=
